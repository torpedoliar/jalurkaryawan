{
  "expo": {
    "name": "Bus Karyawan",
    "slug": "bms-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "android": {
      "package": "com.santosjayaabadi.bms"
    },
    "extra": {
      "eas": {
        "projectId": "00000000-0000-0000-0000-000000000000"
      }
    },
    "plugins": [
      "expo-font",
      ["expo-camera", { "cameraPermission": "Izinkan kamera untuk memindai QR bus dan tiket.", "recordAudioAndroid": false }],
      ["expo-location", { "locationAlwaysAndWhenInUsePermission": "Bagikan lokasi hanya selama perjalanan pengemudi aktif.", "isIosBackgroundLocationEnabled": true, "isAndroidBackgroundLocationEnabled": true, "isAndroidForegroundServiceEnabled": true }]
    ]
  }
}
